# Backend configuration for LOCAL development.
#
# Copy to backend/.env and fill in. A deployed task gets these from its ECS task
# definition instead (see infrastructure/main.tf), so this file only matters when
# running uvicorn on your machine.
#
# Terraform names resources <project>-<environment>-<suffix>, so substitute the
# project_name and environment from your infrastructure/tfvars/<env>.tfvars.
# With project_name="resilience-review" and environment="dev", the documents
# bucket is resilience-review-dev-documents-<account-id>.

# --- AWS ---
AWS_REGION=us-east-1
# Leave blank to use ambient credentials (AWS_PROFILE or an instance role) —
# preferred over pasting long-lived keys into a file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Storage (both required; the app refuses to start without them) ---
S3_DOCUMENTS_BUCKET=<project>-<env>-documents-<account-id>
# Table names derive from this: <prefix>-documents, <prefix>-validations, ...
DYNAMODB_TABLE_PREFIX=<project>-<env>

# --- Bedrock ---
# Model IDs default to the tier constants in app/bedrock_models.py. Set this only
# to override the general-purpose model; per-stage overrides
# (VALIDATION_MODEL_ID, EXTRACTION_DIAGRAM_MODEL_ID, ...) are documented under
# `extra_container_env` in infrastructure/variables.tf.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_MAX_TOKENS=4096

# --- Bedrock Knowledge Base (optional) ---
# Without these the cross-document "Ask Documents" path is unavailable;
# everything else works.
KNOWLEDGE_BASE_ID=
DATA_SOURCE_ID=

# --- RBAC bootstrap ---
# Comma-separated emails that always resolve to admin, so a first admin exists
# before any role rows are written.
BOOTSTRAP_ADMIN_EMAIL=

# --- Microsoft Teams notifications (optional) ---
# Required only by the /api/teams webhook route.
TEAMS_WEBHOOK_URL=

# --- Application ---
LOG_LEVEL=INFO
# Comma-separated allowed origins. "*" is fine locally; set the real CloudFront
# URL for anything shared.
CORS_ORIGINS=*
