height="46" as="geometry"/></mxCell><mxCell id="n49" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1490" y="830" width="46" height="46" as="geometry"/></mxCell><mxCell id="n50" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1890" y="530" width="46" height="46" as="geometry"/></mxCell><mxCell id="n51" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="1100" width="46" height="46" as="geometry"/></mxCell><mxCell id="panel" value="" style="rounded=0;fillColor=#EAEDED;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2160" y="0" width="1040" height="1320" as="geometry"/></mxCell><mxCell id="n52" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2200" y="141" width="46" height="46" as="geometry"/></mxCell><mxCell id="s53" value="Users open the web app through &lt;b&gt;Amazon CloudFront&lt;/b&gt;, which serves the static frontend from an &lt;b&gt;Amazon Simple Storage Service (Amazon S3)&lt;/b&gt; bucket." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=25;fontFamily=Arial;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="2272" y="145" width="890" height="64" as="geometry"/></mxCell><mxCell id="n54" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2200" y="239" width="46" height="46" as="geometry"/></mxCell><mxCell id="s55" value="Users sign in with &lt;b&gt;Amazon Cognito&lt;/b&gt;, optionally federated with a corporate identity provider over SAML. An &lt;b&gt;AWS Lambda&lt;/b&gt; function maps directory groups to the admin, curator, validator, and viewer roles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=25;fontFamily=Arial;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="2272" y="243" width="890" height="96" as="geometry"/></mxCell><mxCell id="n56" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2200" y="369" width="46" height="46" as="geometry"/></mxCell><mxCell id="s57" value="CloudFront forwards API calls to an &lt;b&gt;Application Load Balancer&lt;/b&gt; that accepts only CloudFront traffic. The API runs on &lt;b&gt;Amazon Elastic Container Service (Amazon ECS)&lt;/b&gt; with &lt;b&gt;AWS Fargate&lt;/b&gt; in private subnets across two Availability Zones, beside a PowerPoint-to-PDF converter. A &lt;b&gt;NAT gateway&lt;/b&gt; provides outbound access." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=25;fontFamily=Arial;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="2272" y="373" width="890" height="160" as="geometry"/></mxCell><mxCell id="n58" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2200" y="563" width="46" height="46" as="geometry"/></mxCell><mxCell id="s59" value="Uploaded standards and design documents, their rendered pages and diagrams, icon-legend images, and validation findings are stored in &lt;b&gt;Amazon S3&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=25;fontFamily=Arial;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="2272" y="567" width="890" height="64" as="geometry"/></mxCell><mxCell id="n60" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2200" y="661" width="46" height="46" as="geometry"/></mxCell><mxCell id="s61" value="Rule extraction, validation, curation, and question answering call models on &lt;b&gt;Amazon Bedrock&lt;/b&gt;. An &lt;b&gt;Amazon Bedrock Guardrails&lt;/b&gt; policy applies to every call." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=25;fontFamily=Arial;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="2272" y="665" width="890" height="96" as="geometry"/></mxCell><mxCell id="n62" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2200" y="791" width="46" height="46" as="geometry"/></mxCell><mxCell id="s63" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt; holds the rule library, references, icon legend, validation metadata, user roles, and the audit trail." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=25;fontFamily=Arial;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="2272" y="795" width="890" height="64" as="geometry"/></mxCell><mxCell id="n64" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2200" y="889" width="46" height="46" as="geometry"/></mxCell><mxCell id="s65" value="&lt;b&gt;Amazon Bedrock Knowledge Bases&lt;/b&gt; indexes the documents in an &lt;b&gt;Amazon OpenSearch Serverless&lt;/b&gt; vector index, so answers cite the passages they draw on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=25;fontFamily=Arial;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="2272" y="893" width="890" height="96" as="geometry"/></mxCell><mxCell id="n66" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2200" y="1019" width="46" height="46" as="geometry"/></mxCell><mxCell id="s67" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt; alarms notify through &lt;b&gt;Amazon Simple Notification Service (Amazon SNS)&lt;/b&gt;, &lt;b&gt;AWS X-Ray&lt;/b&gt; traces requests, and &lt;b&gt;AWS CloudTrail&lt;/b&gt; records API activity. &lt;b&gt;AWS Key Management Service (AWS KMS)&lt;/b&gt; keys encrypt data at rest. Images come from &lt;b&gt;Amazon Elastic Container Registry (Amazon ECR)&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=25;fontFamily=Arial;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="2272" y="1023" width="890" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>