{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-pdf-worker": "node -e \"const fs=require('fs'),path=require('path'); const pdfjsPkg=require.resolve('pdfjs-dist/package.json',{paths:[require.resolve('react-pdf')]}); const src=path.join(path.dirname(pdfjsPkg),'build','pdf.worker.min.mjs'); fs.copyFileSync(src,'public/pdf.worker.min.mjs'); console.log('pdf.worker.min.mjs synced from pdfjs-dist@'+require(pdfjsPkg).version);\"",
    "predev": "npm run sync-pdf-worker",
    "prebuild": "npm run sync-pdf-worker",
    "dev": "next dev",
    "dev:webpack": "DISABLE_TURBOPACK=1 next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "aws-amplify": "^6.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
