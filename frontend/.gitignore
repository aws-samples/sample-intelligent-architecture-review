# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pdf.js worker — synced from react-pdf's pinned pdfjs-dist on every
# predev/prebuild (see package.json "sync-pdf-worker"). It's a build
# artifact, not source: committing it risks a version drift vs the worker
# API and pollutes lint (it's minified). Regenerated on every build/deploy.
/public/pdf.worker.min.mjs
