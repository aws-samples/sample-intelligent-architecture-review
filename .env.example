# Root deploy credentials — copy to .env and fill in, then `source .env`
# before running ./deploy.sh. This points your shell at the TARGET AWS
# account. .env is gitignored; never commit real keys.
#
# Alternatively, skip this file and use an AWS profile:
#   export AWS_PROFILE=<profile>
#
# deploy.sh reads project name / region / resource names from the tfvars
# file you select with ENVIRONMENT — NOT from here. This file is only the
# AWS credentials + default region.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: for temporary/assumed-role credentials.
# AWS_SESSION_TOKEN=
